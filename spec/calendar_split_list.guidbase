team/schedule:page(title: "球队日程", params:"team_id")<
  cal_view:calendar(
    placement: "top",
    variable: "selected_date",
    data: "schedule_event?event_date>=event_date.first_day_of_week&event_date<=event_date.last_day_of_week",
    view: "week"
  ),
  event_list:split_list(
    group: "event_type",
    data: "schedule_event?event_date=selected_date",
    next: "@grid/display_form_page?person_id",
    title: "$selected_date"
  )<
    eventId!!: hidden,
    eventType: dict(property:"status"),
    title: text(property:"primary"),
    vsTeam: text(property:"secondary"),
    time: text(property:"start_date"),
    location: text(property:"tertiary")
  >
>

grid/display_form_page:page(title:"详情页面")<
  demo_form:entry_form(title:"编辑表单", data:"demo", cols:"3")<
    person_id:hidden,
    image:image(title:"图片", group:"分组1"),
    date1:date(title:"日期", required:"true"),
    text1:text(title:"文本", required:"true"),
    num1:number(title:"数字", required:"true")
  >
>
