form/entry_form_page:page(title:"输入表单页面")<
  demo_entry:entry_form(title:"输入表单",data:"demo", cols:"3")<
    avatar:avatar(title:"头像", group:"分组1", span:"3"),
    date1:date(title:"日期", required:"true", group:"分组1"),
    text1:text(title:"文本", required:"true", group:"分组1"),
    num1:number(title:"数字", required:"true", group:"分组1", unit:"米/秒"),
    sel10:select(title:"下拉框", required:"true", data:"enum[Y:YES('是'),N:NO('否'),U:UNKNOWN('未知')]", group:"分组1"),
    cas1:cascade(title:"级联选择", group:"分组1", span:"2"),
    mul1:multiselect(title:"多选框", group:"分组1", span:"2"),
    time1:time(title:"时间", group:"分组1"),
    tags1:tags(title:"标签", required:"true", group:"分组1", span:"3"),
    longtext1:longtext(title:"长文本", group:"分组1", span:"3"),
    images:images(title:"图片", group:"分组1", span:"3"),
    videos:videos(title:"视频", group:"分组1", span:"3"),
    files:files(title:"文件", group:"分组1", span:"3"),
    
    date2:date(title:"日期", group:"分组2"),
    text2:text(title:"文本", group:"分组2"),
    num2:number(title:"只读数字", group:"分组2", unit:"%/天", readonly:"true"),
    cas2:cascade(title:"级联选择", group:"分组2", span:"2"),
    sel2:select(title:"下拉框", group:"分组2"),
    longtext2:longtext(title:"长文本", group:"分组2", span:"3"),

    date3:date(title:"日期", group:"分组3"),
    text3:text(title:"只读文本", group:"分组3", readonly:"true"),
    num3:number(title:"数字", group:"分组3", unit:"千瓦时"),
    sel30:select(title:"下拉框", group:"分组3"),
    sel31:select(title:"下拉框", data:"enum[Y:YES('大瓜'),N:NO('二瓜'),U:UNKNOWN('三瓜')]", group:"分组3", span:"2"),
    longtext3:longtext(title:"长文本", group:"分组3", span:"3")
  >,
  buttons(placement:"bottom",title:"按钮")<
    button(action:"save", title:"保存", ref:"demo_entry"),
    button(action:"reset", title:"重置", ref:"demo_entry")
  >
>
