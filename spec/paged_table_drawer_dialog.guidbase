table/paged_table_page:page(title:"数据表格")<
  demo_criteria:criteria_form(title:"")<
    date1:date(title:"日期"),
    text1:text(title:"文本", placeholder:"一个文本"),
    num1:number(title:"数字", placeholder:"一个数字"),
    sel10:select(title:"下拉框", data:"enum[Y:YES('是'),N:NO('否'),U:UNKNOWN('未知')]"),
    criteria_search:button(action:"@demo_table.search", title:"搜索"),
    criteria_reset:button(action:"@demo_criteria.reset", title:"重置")
  >,
  demo_table:paged_table(data:"demo?{demo_criteria}")<
    date1:date(title:"日期"),
    text1:text(title:"文本"),
    num1:number(title:"数字", unit:"米/秒"),
    mul1:multiselect(title:"多选框", span:"2"),
    time1:time(title:"时间"),
    tags1:tags(title:"标签", span:"3"),
    
    buttons(title:"操作",width:"180")<
      demo_table_edit:button(action:"#form/demo_dialog_page", title:"编辑"),
      demo_table_view:button(action:"%form/demo_drawer_page", title:"查看"),
      demo_table_remove:button(action:"@demo_table.remove", title:"删除")
    >
  >
>

form/demo_dialog_page:page(title:"弹出窗框中的编辑表单",data:"demo?demoId")<
  demo_entry:entry_form(data: "demo", title:"弹出窗框中的编辑表单", cols:"1")<
    date1:date(title:"日期"),
    text1:text(title:"文本"),
    num1:number(title:"数字", unit:"米/秒"),
    sel10:select(title:"下拉框"),
    cas1:cascade(title:"级联选择", span:"2"),
    mul1:multiselect(title:"多选框", span:"2"),
    time1:time(title:"时间"),
    tags1:tags(title:"标签", span:"3")
  >,
  buttons<
    demo_display_save:button(action:"@demo_entry.save", title:"保存"),
    demo_display_close:button(action:"@demo_entry.save", title:"关闭")
  >
>

form/demo_drawer_page:page(title:"滑动抽屉中的只读表单",data:"demo?demoId")<
  demo_display:display_form(data: "demo", title:"滑动抽屉中的只读表单", cols:"1")<
    date1:date(title:"日期"),
    text1:text(title:"文本"),
    num1:number(title:"数字", unit:"米/秒"),
    sel10:select(title:"下拉框"),
    cas1:cascade(title:"级联选择", span:"2"),
    mul1:multiselect(title:"多选框", span:"2"),
    time1:time(title:"时间"),
    tags1:tags(title:"标签", span:"3")
  >
>
