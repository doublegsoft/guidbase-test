demo_segs_page:page(title:"分段查询")<
  demo_segs:segments(title: "分段查询")<
    seg1:text(title:"激情"),
    seg2:text(title:"刺激"),
    seg3:text(title:"牛逼"),
    seg4:text(title:"英勇")
  >,
  demo_list:list_view(title:"瓦片列表", data:"demo", cols:"3", next:"list_form_page?person_id")<
    person_id:hidden,
    avatar:avatar(title:"头像", property:"avatar"),
    text1:text(title:"姓名/文本", property:"primary"),
    date1:date(title:"开始日期", property:"start_time"),
    date2:date(title:"结束日期", property:"end_time"),
    num1:number(title:"业务数值", unit:"米/秒", property:"status"),
    sel10:select(title:"确认状态", property:"tag", data:"enum[Y:YES('是'),N:NO('否'),U:UNKNOWN('未知')]"),
    longtext1:text(title:"详情描述", property:"secondary")
  >
>

list_form_page:page(title:"列表详情页面")<
  demo_form:display_form(title:"瓦片列表", data:"demo?personId", cols:"3")<
    person_id:hidden,
    avatar:avatar(title:"头像", group:"分组1"),
    date1:date(title:"日期", group:"分组2"),
    text1:text(title:"文本", group:"分组2"),
    num1:number(title:"数字", group:"分组2")
  >
>
