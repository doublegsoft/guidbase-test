statistics_page:page(module: "fa", title: "数据统计")<

  statistics_tabs:tabs(title: "统计报表")<
    team_tab:tab(title: "队伍统计")<
      team_attendance_table:paged_table(title: "各队出勤率", object: "team", viewport: "drawer")<
        name:text(title: "队伍"),
        age_group:text(title: "年龄段"),
        attendance_rate:text(title: "出勤率")
      >,

      team_match_table:paged_table(title: "各队战绩", object: "team", viewport: "drawer")<
        name:text(title: "队伍"),
        win_count:text(title: "胜"),
        draw_count:text(title: "平"),
        lose_count:text(title: "负"),
        win_rate:text(title: "胜率")
      >
    >,

    player_tab:tab(title: "学员排行")<
      player_attendance_table:paged_table(title: "出勤排行", object: "student", viewport: "drawer")<
        name:text(title: "姓名"),
        team:text(title: "队伍"),
        attendance_rate:text(title: "出勤率"),
        avg_rating:text(title: "平均评分")
      >,

      player_match_table:paged_table(title: "比赛数据排行", object: "student", viewport: "drawer")<
        name:text(title: "姓名"),
        team:text(title: "队伍"),
        total_goals:text(title: "总进球"),
        total_assists:text(title: "总助攻"),
        total_matches:text(title: "出场次数")
      >
    >,

    training_tab:tab(title: "训练统计")<
      monthly_training_table:paged_table(title: "月度训练", object: "training_session", viewport: "drawer")<
        month:text(title: "月份"),
        total_count:text(title: "训练次数"),
        avg_attendance:text(title: "平均出勤率")
      >
    >
  >
>
