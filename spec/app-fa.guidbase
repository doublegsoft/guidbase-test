dashboard_page:page(module: "fa", title: "仪表盘")<

  today_training_table:paged_table(title: "今日训练", object: "training_session", viewport: "drawer")<
    training_date:date(title: "日期"),
    start_time:time(title: "开始"),
    team:text(title: "队伍"),
    coach:text(title: "教练"),
    topic:text(title: "主题"),
    venue:text(title: "场地"),
    status:select(title: "状态")
  >,

  recent_match_table:paged_table(title: "近期比赛", object: "match", viewport: "drawer")<
    match_date:date(title: "日期"),
    team:text(title: "队伍"),
    opponent:text(title: "对手"),
    result:select(title: "结果"),
    match_type:select(title: "类型")
  >
>

student_list_page:page(module: "fa", title: "学员管理")<

  student_criteria:criteria_form(title: "学员查询", object: "student", cols: "4")<
    name:text(title: "姓名"),
    student_no:text(title: "学员编号"),
    team:select(title: "所属队伍"),
    status:select(title: "状态"),
    position:select(title: "场上位置"),
    enroll_date_start:date(title: "入训从"),
    enroll_date_end:date(title: "入训至")
  >,

  student_table:paged_table(title: "学员列表", object: "student", viewport: "drawer")<
    avatar:avatar(title: "头像"),
    student_no:text(title: "学员编号"),
    name:text(title: "姓名"),
    gender:select(title: "性别"),
    team:text(title: "队伍"),
    position:select(title: "位置"),
    enroll_date:date(title: "入训日期"),
    status:select(title: "状态")
  >,

  student_form:entry_form(title: "学员信息", object: "student", viewport: "dialog", cols: "3")<
    avatar:avatar(title: "头像", size: "(88,88)"),
    name:text(title: "姓名", span: "2"),
    student_no:text(title: "学员编号"),
    gender:select(title: "性别"),
    birth_date:date(title: "出生日期"),
    phone:text(title: "联系电话"),
    position:select(title: "场上位置"),
    team:select(title: "所属队伍"),
    height:text(title: "身高(cm)"),
    weight:text(title: "体重(kg)"),
    school:text(title: "就读学校"),
    enroll_date:date(title: "入训日期"),
    status:select(title: "状态"),
    guardian:select(title: "监护人"),
    note:longtext(title: "备注", span: "3")
  >
>

student_detail_page:page(module: "fa", title: "学员详情")<

  student_detail:display_form(title: "基本信息", object: "student", viewport: "drawer", cols: "3")<
    avatar:avatar(title: "头像", size: "(110,110)"),
    name:text(title: "姓名", span: "2"),
    student_no:text(title: "学员编号"),
    gender:select(title: "性别"),
    birth_date:date(title: "出生日期"),
    phone:text(title: "联系电话"),
    position:select(title: "位置"),
    team:text(title: "所属队伍"),
    height:text(title: "身高(cm)"),
    weight:text(title: "体重(kg)"),
    school:text(title: "就读学校"),
    enroll_date:date(title: "入训日期"),
    status:select(title: "状态"),
    guardian:text(title: "监护人"),
    note:longtext(title: "备注", span: "3")
  >,

  student_detail_tabs:tabs(title: "历史记录")<
    attendance_tab:tab(title: "出勤记录")<
      student_attendance_table:paged_table(title: "出勤记录", object: "attendance", viewport: "drawer")<
        training_session:text(title: "训练课"),
        training_date:date(title: "日期"),
        status:select(title: "出勤"),
        rating:text(title: "评分"),
        note:text(title: "备注")
      >
    >,

    match_tab:tab(title: "比赛记录")<
      student_match_table:paged_table(title: "比赛记录", object: "match_player", viewport: "drawer")<
        match:text(title: "比赛"),
        match_date:date(title: "日期"),
        jersey_number:text(title: "球衣号"),
        position:select(title: "位置"),
        goals:text(title: "进球"),
        assists:text(title: "助攻"),
        minutes_played:text(title: "出场时间"),
        status:select(title: "出场")
      >
    >
  >
>

